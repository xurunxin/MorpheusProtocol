{
  "name": "@morpheus/sdk",
  "version": "0.1.0",
  "description": "Client-only Agent OS application SDK",
  "type": "module",
  "files": [
    "dist",
    "src",
    "AGENTS.md"
  ],
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "source": "./src/index.ts",
      "import": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsc -b && bun build src/index.ts --outdir dist --target browser --format esm --external @morpheus/api-protocol",
    "test": "bun test --conditions=source",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "eslint .",
    "prepack": "bun run build"
  },
  "dependencies": {
    "@morpheus/api-protocol": "0.1.5"
  }
}
