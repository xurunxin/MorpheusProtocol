{
  "name": "@xurunxin/morpheus-sdk",
  "version": "0.2.0",
  "description": "Client-only Agent OS application SDK",
  "type": "module",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/xurunxin/MorpheusProtocol.git",
    "directory": "packages/morpheus-sdk"
  },
  "homepage": "https://github.com/xurunxin/MorpheusProtocol#readme",
  "bugs": {
    "url": "https://github.com/xurunxin/MorpheusProtocol/issues"
  },
  "files": [
    "dist",
    "README.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "engines": {
    "node": ">=20",
    "bun": ">=1.3.14"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://npm.pkg.github.com"
  },
  "scripts": {
    "build": "bun x tsc -b --force && bun build src/index.ts --outdir dist --target browser --format esm --external @xurunxin/morpheus-protocol",
    "test": "bun run build && bun test test",
    "typecheck": "bun x tsc -b --force",
    "lint": "bun x eslint src test",
    "prepack": "bun run build"
  },
  "dependencies": {
    "@xurunxin/morpheus-protocol": "0.2.0"
  }
}
